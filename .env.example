# Existing Base44 variables can remain while the migration is in progress.
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=

# Supabase frontend configuration.
# The anon key is safe to expose in Vite when Row Level Security is correctly enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values. Do not expose these to browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Email provider for future Supabase Edge Functions.
RESEND_API_KEY=
EMAIL_FROM="OnSite Timesheet <noreply@example.com>"

# Optional deployment/runtime settings.
APP_PUBLIC_URL=http://localhost:5173

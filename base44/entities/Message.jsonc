{
  "name": "Message",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of recipient, or 'all' for broadcast"
    },
    "recipient_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "message_type": {
      "type": "string",
      "enum": [
        "direct",
        "broadcast"
      ],
      "default": "direct"
    }
  },
  "required": [
    "company_id",
    "sender_email",
    "body"
  ]
}